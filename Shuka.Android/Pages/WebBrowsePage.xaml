<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shuka.Android.Pages.WebBrowsePage"
             BackgroundColor="{DynamicResource BgPage}">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Top bar ───────────────────────────────────────── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="44,44,*,44,44,44"
              HeightRequest="96"
              Padding="8,44,8,8"
              BackgroundColor="{DynamicResource BgCard}">

            <!-- Back button -->
            <Grid Grid.Column="0"
                  x:Name="BackButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE5C4;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="22"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Forward button -->
            <Grid Grid.Column="1"
                  x:Name="ForwardButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Opacity="0.4">
                <Label Text="&#xE5C8;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="22"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForwardTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- URL pill -->
            <Border Grid.Column="2"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource BgInput}"
                    HeightRequest="34"
                    Padding="10,0"
                    VerticalOptions="Center">
                <Label x:Name="UrlBarLabel"
                       FontSize="11"
                       TextColor="{DynamicResource TextMuted}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Border>

            <!-- Ad blocker toggle -->
            <Grid Grid.Column="3"
                  x:Name="AdBlockerButton"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label x:Name="AdBlockerIcon"
                       Text="&#xE14B;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAdBlockerToggleTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Reload button -->
            <Grid Grid.Column="4"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE5D5;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnReloadTapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Home / close source button -->
            <Grid Grid.Column="5"
                  WidthRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xE88A;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="20"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeSourceTapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- ── WebView + FAB overlay ─────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- WebView -->
            <WebView x:Name="SiteWebView"
                     Navigating="OnNavigating"
                     Navigated="OnNavigated" />

            <!-- Loading bar -->
            <ProgressBar x:Name="LoadingBar"
                         Progress="0"
                         ProgressColor="{DynamicResource AccentLight}"
                         VerticalOptions="Start"
                         HeightRequest="3"
                         IsVisible="False" />

            <!-- Full-page spinner while escaping Google Translate (no about:blank dead time) -->
            <Grid x:Name="LeaveOriginalOverlay"
                  IsVisible="False"
                  BackgroundColor="#99101010">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12"
                                     Margin="32">
                    <ActivityIndicator x:Name="LeaveOriginalSpinner"
                                       IsRunning="True"
                                       Color="{DynamicResource AccentLight}"
                                       HorizontalOptions="Center"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Opening original page…"
                           TextColor="{DynamicResource TextPrimary}"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="LeaveOriginalSubtitle"
                           FontSize="10"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalTextAlignment="Center"
                           MaxLines="3"
                           LineBreakMode="MiddleTruncation" />
                </VerticalStackLayout>
            </Grid>

            <!-- FABs — bottom-right corner, collapsible menu -->
            <VerticalStackLayout x:Name="FabContainer"
                                 HorizontalOptions="End"
                                 VerticalOptions="End"
                                 Spacing="10"
                                 Margin="0,0,16,28">

                <!-- Collapsible FAB menu items (hidden by default) -->
                <VerticalStackLayout x:Name="FabMenuItems"
                                     Spacing="10"
                                     HorizontalOptions="End"
                                     IsVisible="False"
                                     Opacity="0">

                    <!-- Row 1: Utility buttons (Bookmark, Translate, Browser) -->
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End">

                        <!-- Bookmark FAB — toggles bookmark state -->
                        <Border x:Name="FabBookmark"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label x:Name="FabBookmarkIcon"
                                       Text="&#xE866;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="FabBookmarkLabel"
                                       Text="BOOKMARK"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBookmarkTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Translate FAB — toggles Google Translate proxy -->
                        <Border x:Name="FabTranslate"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label x:Name="FabTranslateIcon"
                                       Text="&#xE8E2;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label x:Name="FabTranslateLabel"
                                       Text="TRANSLATE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTranslateTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Browser FAB — always visible -->
                        <Border x:Name="FabBrowser"
                                BackgroundColor="{DynamicResource BgCard}"
                                Stroke="{DynamicResource Stroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xE89E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                                <Label Text="BROWSER"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenInBrowserTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>

                    <!-- Row 2: Action buttons (Fetch, Download) -->
                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End">

                        <!-- Fetch FAB — shown on novel pages, pre-fills Download tab URL -->
                        <Border x:Name="FabFetch"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="14,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xE2C4;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="16"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                                <Label Text="FETCH"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFetchFabTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Download FAB — shown only on supported novel pages -->
                        <Border x:Name="FabDownload"
                                BackgroundColor="{DynamicResource Accent}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24"
                                HeightRequest="44"
                                Padding="16,0"
                                IsVisible="False">
                            <HorizontalStackLayout Spacing="6"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center">
                                <Label Text="&#xF090;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="18"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                                <Label Text="DOWNLOAD"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextOnAccent}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDownloadFabTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <!-- Toggle FAB — always visible, expands/collapses menu -->
                <Border x:Name="FabToggle"
                        BackgroundColor="{DynamicResource Accent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        WidthRequest="56"
                        HeightRequest="56"
                        HorizontalOptions="End">
                    <Label x:Name="FabToggleIcon"
                           Text="&#xE5CE;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="24"
                           TextColor="{DynamicResource TextOnAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Rotation="0" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFabToggleTapped" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>

            <!-- Queued toast — bottom-center -->
            <Border x:Name="QueuedToast"
                    BackgroundColor="{DynamicResource Accent}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="18,12"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,90"
                    IsVisible="False">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="&#xE86C;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="16"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                    <Label x:Name="QueuedToastLabel"
                           Text="Queued!"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource TextOnAccent}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Invalid URL banner — bottom-center, warning style -->
            <Border x:Name="InvalidUrlBanner"
                    BackgroundColor="{DynamicResource BgCard}"
                    Stroke="{DynamicResource Stroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14"
                    HorizontalOptions="Fill"
                    VerticalOptions="End"
                    Margin="16,0,16,90"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="&#xE002;"
                           FontFamily="{DynamicResource IconFont}"
                           FontSize="22"
                           TextColor="{DynamicResource Warning}"
                           VerticalOptions="Start"
                           Margin="0,1,0,0" />
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Not a downloadable novel page"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label x:Name="InvalidUrlHintLabel"
                               FontSize="11"
                               TextColor="{DynamicResource TextMuted}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
